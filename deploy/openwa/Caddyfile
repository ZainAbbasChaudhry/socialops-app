# Replace with the real hostname before deploying. Caddy obtains and renews
# the TLS certificate automatically, which requires this name to already
# resolve to this server's public IP (see README.md).
wa.easylife.com.pk {
	encode gzip

	# The gateway is reached only through here; it never binds a host port.
	reverse_proxy openwa:3010 {
		health_uri /health
	}

	log {
		output stdout
		format console
	}
}
