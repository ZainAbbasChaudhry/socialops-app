# EasyLife OpenWA gateway - copy to .env and fill in. Never commit .env.
#
# Generate each secret with:  openssl rand -hex 32

# Port the gateway listens on inside the container. Caddy terminates TLS in
# front of it, so this is plain HTTP and must NOT be exposed publicly.
PORT=3010

# Shared secret the dashboard sends as `X-Api-Key` on every gateway call.
# Must match the "Gateway API key" saved in the dashboard's Integrations page.
OPENWA_API_KEY=

# Secret this gateway signs every outbound webhook with (HMAC-SHA256, sent
# as `X-OpenWA-Signature: sha256=<hex>`). Must match the "Webhook signing
# secret" saved in the dashboard. Different from OPENWA_API_KEY on purpose:
# one authenticates dashboard -> gateway, the other gateway -> dashboard.
OPENWA_WEBHOOK_SECRET=

# Where inbound messages and session-state changes are delivered.
DASHBOARD_WEBHOOK_URL=https://dashboard.easylife.com.pk/api/webhooks/openwa

# Directory holding paired session credentials. MUST be on a persistent
# volume - losing it means every workspace has to re-scan a QR code.
SESSIONS_DIR=/data/sessions
