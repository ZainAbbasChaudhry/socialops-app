# Copy to .env in this same folder (tools/whatsapp-demo-bridge/.env) and fill in.
# This .env is already covered by the repo's root .gitignore ("*.env" style
# rules) - never commit it. Nothing here is read by the main dashboard app.

# Port the bridge's own HTTP API listens on.
PORT=4001

# gemini | ollama - which AI provider generates replies.
# Gemini's EasyLife platform key is currently known to return
# "prepayment credits are depleted" (HTTP 429) - use ollama for the live
# demo unless that's been resolved.
DEMO_RAG_AI_PROVIDER=ollama

# Only needed if DEMO_RAG_AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Only used if DEMO_RAG_AI_PROVIDER=ollama. Must already be pulled locally
# (`ollama list` to check, `ollama pull <name>` to fetch) - the bridge will
# NOT download a model automatically. Point this at whatever capable model
# you already have (e.g. qwen3:8b, llama3.1:8b, mistral).
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated E.164-ish numbers (digits only, no +) - if set, the bot
# only auto-replies to these. Leave blank during setup/testing with your
# own phone, set it before the actual client demo if you want to restrict
# who the bot responds to.
DEMO_WHATSAPP_ALLOWED_NUMBERS=

# Kill switch - false means inbound messages are still observed/logged and
# shown in the dashboard, but no WhatsApp reply is actually sent.
DEMO_WHATSAPP_AUTO_REPLY=true

# Comma-separated origins allowed to call this bridge's API from a browser.
# The Next.js dashboard runs on localhost:3000 in dev by default.
CORS_ORIGIN=http://localhost:3000
