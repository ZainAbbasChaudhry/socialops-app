# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / coverage
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# misc OS files
.DS_Store
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials / keys — should never be committed
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json

# archives / stray build artifacts
*.zip

# WhatsApp QR demo bridge (tools/whatsapp-demo-bridge/) - isolated, local-only
# demo tool. Never commit session data, browser profiles, or conversation logs.
tools/whatsapp-demo-bridge/.wwebjs_auth/
tools/whatsapp-demo-bridge/.wwebjs_cache/
tools/whatsapp-demo-bridge/node_modules/
tools/whatsapp-demo-bridge/*.log
